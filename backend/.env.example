SUPABASE_DB_USERNAME=postgres.<project-ref>
SUPABASE_DB_PASSWORD=<supabase-db-password>

JWT_SECRET=<base64-or-long-random-secret>

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://<frontend-domain>.vercel.app

